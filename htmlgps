<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rastreo GPS en Tiempo Real</title>

  <!-- Leaflet 1.9.4 CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #1a1a1a;
      color: #f1f5f9;
    }

    #map {
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Panel flotante de telemetría */
    .dashboard-panel {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 1000;
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 16px;
      width: 320px;
      max-width: calc(100vw - 32px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
      transition: all 0.3s ease;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .panel-title {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #94a3b8;
    }

    /* Badge de estado */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      padding: 4px 8px;
      border-radius: 20px;
      background: #334155;
      color: #cbd5e1;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #94a3b8;
    }

    .status-online {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .status-online .status-dot {
      background: #10b981;
      box-shadow: 0 0 8px #10b981;
    }

    .status-waiting {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .status-waiting .status-dot {
      background: #f59e0b;
      box-shadow: 0 0 8px #f59e0b;
    }

    .status-offline {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .status-offline .status-dot {
      background: #ef4444;
      box-shadow: 0 0 8px #ef4444;
    }

    /* Grilla de métricas */
    .metrics-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 14px;
    }

    .metric-card {
      background: rgba(255, 255, 255, 0.04);
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .metric-label {
      font-size: 11px;
      color: #94a3b8;
      margin-bottom: 2px;
      text-transform: uppercase;
    }

    .metric-val {
      font-size: 16px;
      font-weight: 700;
      color: #f8fafc;
    }

    .metric-val span {
      font-size: 11px;
      font-weight: 400;
      color: #94a3b8;
      margin-left: 2px;
    }

    /* Coordenadas e info adicional */
    .extra-info {
      font-size: 11px;
      color: #94a3b8;
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 8px 10px;
      background: rgba(0, 0, 0, 0.2);
      border-radius: 6px;
      margin-bottom: 12px;
    }

    /* Botonera de control */
    .controls {
      display: flex;
      gap: 8px;
    }

    .btn {
      flex: 1;
      padding: 8px 10px;
      background: #2563eb;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      transition: background 0.2s ease;
    }

    .btn:hover {
      background: #1d4ed8;
    }

    .btn-secondary {
      background: #334155;
      color: #f1f5f9;
    }

    .btn-secondary:hover {
      background: #475569;
    }

    .btn.active {
      background: #059669;
    }

    /* Marcador GPS personalizado con pulso */
    .gps-marker-container {
      position: relative;
      width: 22px;
      height: 22px;
    }

    .gps-pulse {
      position: absolute;
      top: -9px;
      left: -9px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(37, 99, 235, 0.4);
      animation: pulse-animation 2s infinite ease-out;
    }

    .gps-dot {
      position: absolute;
      top: 0;
      left: 0;
      width: 22px;
      height: 22px;
      background: #2563eb;
      border: 3px solid #ffffff;
      border-radius: 50%;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    }

    @keyframes pulse-animation {
      0% {
        transform: scale(0.5);
        opacity: 0.9;
      }
      100% {
        transform: scale(1.6);
        opacity: 0;
      }
    }
  </style>
</head>
<body>

  <!-- Contenedor del Mapa -->
  <div id="map"></div>

  <!-- Panel de Telemetría -->
  <div class="dashboard-panel">
    <div class="panel-header">
      <span class="panel-title">Rastreador GPS</span>
      <div id="statusBadge" class="status-badge status-waiting">
        <span class="status-dot"></span>
        <span id="statusText">Conectando...</span>
      </div>
    </div>

    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-label">Velocidad</div>
        <div class="metric-val" id="valSpeed">-- <span>km/h</span></div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Altitud</div>
        <div class="metric-val" id="valAlt">-- <span>m</span></div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Satélites</div>
        <div class="metric-val" id="valSats">--</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">Precisión (HDOP)</div>
        <div class="metric-val" id="valHdop">--</div>
      </div>
    </div>

    <div class="extra-info">
      <div><strong>Lat/Lng:</strong> <span id="valCoords">Esperando señal...</span></div>
      <div><strong>Último reporte:</strong> <span id="valAge">--</span></div>
    </div>

    <div class="controls">
      <button id="btnFollow" class="btn active" title="Alternar recentrado automático">Auto-seguir: ON</button>
      <button id="btnCenter" class="btn btn-secondary" title="Centrar en la posición actual">Centrar</button>
    </div>
  </div>

  <!-- Leaflet 1.9.4 JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // --- ESTADO DE LA APLICACIÓN ---
    let autoFollow = true;
    let currentMarker = null;
    let trackPolyline = null;
    let lastValidLocation = null;
    let initialBoundsSet = false;

    // --- ELEMENTOS DEL DOM ---
    const statusBadge = document.getElementById('statusBadge');
    const statusText = document.getElementById('statusText');
    const valSpeed = document.getElementById('valSpeed');
    const valAlt = document.getElementById('valAlt');
    const valSats = document.getElementById('valSats');
    const valHdop = document.getElementById('valHdop');
    const valCoords = document.getElementById('valCoords');
    const valAge = document.getElementById('valAge');
    const btnFollow = document.getElementById('btnFollow');
    const btnCenter = document.getElementById('btnCenter');

    // --- INICIALIZAR MAPA ---
    // Inicia con una vista genérica neutra que luego se ajusta automáticamente
    const map = L.map('map', {
      zoomControl: false
    }).setView([0, 0], 2);

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    // Si el usuario arrastra manualmente el mapa, desactivar temporalmente auto-follow
    map.on('dragstart', () => {
      if (autoFollow) {
        toggleAutoFollow(false);
      }
    });

    // Icono animado para el marcador actual
    const gpsIcon = L.divIcon({
      className: 'gps-custom-icon',
      html: `
        <div class="gps-marker-container">
          <div class="gps-pulse"></div>
          <div class="gps-dot"></div>
        </div>
      `,
      iconSize: [22, 22],
      iconAnchor: [11, 11]
    });

    // Crear polilínea azul para el recorrido
    trackPolyline = L.polyline([], {
      color: '#2563eb',
      weight: 4,
      opacity: 0.85,
      smoothFactor: 1
    }).addTo(map);

    // --- FUNCIONES DE INTERFAZ ---
    function setStatus(state, message) {
      statusBadge.className = 'status-badge ' + (
        state === 'online' ? 'status-online' :
        state === 'waiting' ? 'status-waiting' : 'status-offline'
      );
      statusText.textContent = message;
    }

    function toggleAutoFollow(forceState) {
      autoFollow = forceState !== undefined ? forceState : !autoFollow;
      if (autoFollow) {
        btnFollow.classList.add('active');
        btnFollow.textContent = 'Auto-seguir: ON';
        if (lastValidLocation) {
          map.panTo([lastValidLocation.lat, lastValidLocation.lng]);
        }
      } else {
        btnFollow.classList.remove('active');
        btnFollow.textContent = 'Auto-seguir: OFF';
      }
    }

    btnFollow.addEventListener('click', () => toggleAutoFollow());

    btnCenter.addEventListener('click', () => {
      if (lastValidLocation) {
        map.setView([lastValidLocation.lat, lastValidLocation.lng], Math.max(map.getZoom(), 16));
      }
    });

    function formatTime(timestamp) {
      if (!timestamp) return '--';
      const d = new Date(timestamp);
      return d.toLocaleTimeString('es-ES', { hour12: false });
    }

    function formatAge(ageMs) {
      if (ageMs === undefined || ageMs === null) return '--';
      const seconds = Math.floor(ageMs / 1000);
      if (seconds < 60) return `hace ${seconds}s`;
      const minutes = Math.floor(seconds / 60);
      return `hace ${minutes}m ${seconds % 60}s`;
    }

    // --- LLAMADAS A LA API ---

    // 1. Cargar recorrido histórico
    async function loadHistory() {
      try {
        const response = await fetch('/api/history', { cache: 'no-store' });
        if (!response.ok) throw new Error('Error al consultar historial');
        
        const historyCoords = await response.json();
        if (Array.isArray(historyCoords) && historyCoords.length > 0) {
          trackPolyline.setLatLngs(historyCoords);
          
          if (!initialBoundsSet) {
            map.fitBounds(trackPolyline.getBounds(), { padding: [50, 50], maxZoom: 16 });
            initialBoundsSet = true;
          }
        }
      } catch (err) {
        console.warn('No se pudo cargar el historial:', err);
      }
    }

    // 2. Consultar posición en tiempo real
    async function fetchLocation() {
      try {
        const response = await fetch('/api/location', { cache: 'no-store' });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        
        const data = await response.json();

        if (!data || !data.valid) {
          setStatus('waiting', 'Sin señal GPS');
          valCoords.textContent = 'A la espera de coordenadas...';
          return;
        }

        // Señal GPS válida recibida
        setStatus('online', 'En vivo');
        lastValidLocation = data;

        // Actualizar métricas del panel
        valSpeed.innerHTML = `${(data.speed ?? 0).toFixed(1)} <span>km/h</span>`;
        valAlt.innerHTML = `${(data.alt ?? 0).toFixed(0)} <span>m</span>`;
        valSats.textContent = data.sats ?? '--';
        valHdop.textContent = data.hdop !== undefined ? data.hdop.toFixed(1) : '--';
        valCoords.textContent = `${data.lat.toFixed(6)}, ${data.lng.toFixed(6)}`;
        valAge.textContent = `${formatAge(data.ageMs)} (${formatTime(data.receivedAt)})`;

        const newPos = [data.lat, data.lng];

        // Mover o crear el marcador
        if (!currentMarker) {
          currentMarker = L.marker(newPos, { icon: gpsIcon }).addTo(map);
        } else {
          currentMarker.setLatLng(newPos);
        }

        // Añadir el nuevo punto a la polilínea del recorrido
        const currentPoints = trackPolyline.getLatLngs();
        const lastPoint = currentPoints[currentPoints.length - 1];
        
        // Evitar duplicados consecutivos exactos
        if (!lastPoint || lastPoint.lat !== data.lat || lastPoint.lng !== data.lng) {
          trackPolyline.addLatLng(newPos);
        }

        // Si es la primera vez que recibimos posición y no había historial previo
        if (!initialBoundsSet) {
          map.setView(newPos, 16);
          initialBoundsSet = true;
        } else if (autoFollow) {
          map.panTo(newPos, { animate: true, duration: 0.8 });
        }

      } catch (err) {
        console.error('Error al actualizar ubicación:', err);
        setStatus('offline', 'Error de red');
      }
    }

    // --- SECUENCIA DE INICIO ---
    async function init() {
      // 1. Obtener historial primero
      await loadHistory();

      // 2. Obtener primera posición
      await fetchLocation();

      // 3. Polling cada 3 segundos
      setInterval(fetchLocation, 3000);
    }

    init();
  </script>
</body>
</html> 
